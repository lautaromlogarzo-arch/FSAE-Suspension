# =============================================================================
#  BLOQUE 2: SOLVER PRINCIPAL (CORREGIDO FÍSICAMENTE)
# =============================================================================

def calcular_dinamica_eje(inputs_eje, vehiculo, es_delantero=True):
    
    # --- MASA SUSPENDIDA GLOBAL (Correcto) ---
    mu_del_ref = front_inputs["mu_kg"]
    mu_tra_ref = rear_inputs["mu_kg"]
    masa_suspendida_total = vehiculo["peso_total_kg"] - (2 * mu_del_ref) - (2 * mu_tra_ref)

    # Fracciones de peso (Weight Bias)
    if es_delantero:
        weight_frac = (vehiculo["dist_ejes_m"] - vehiculo["dist_cg_del_m"]) / vehiculo["dist_ejes_m"]
        df_share = vehiculo["downforce_total_N"] * vehiculo["aero_bal_front_pct"]
    else:
        weight_frac = vehiculo["dist_cg_del_m"] / vehiculo["dist_ejes_m"]
        df_share = vehiculo["downforce_total_N"] * (1 - vehiculo["aero_bal_front_pct"])

    ms = (masa_suspendida_total * weight_frac) / 2
    downforce_por_rueda = df_share / 2

    # 2. Conversiones y MR
    k_tire = inputs_eje["k_tire_input"] * 1000
    k_resorte = inputs_eje["k_resorte_lbs_in"] * 175.127

    vec_pr = [b - a for a, b in zip(inputs_eje["p_pushrod_upright"], inputs_eje["p_pushrod_rocker"])]
    longitud_pr = math.sqrt(sum(c**2 for c in vec_pr))
    factor_angulo = abs(vec_pr[2]) / longitud_pr
    
    mr_damper = factor_angulo * (inputs_eje["brazo_damper_m"] / inputs_eje["brazo_pushrod_m"])
    mr_arb = factor_angulo * (inputs_eje["brazo_arb_m"] / inputs_eje["brazo_pushrod_m"])

    # 3. Rigideces (Wheel Rates)
    kw_spring = k_resorte * mr_damper**2
    
    J = math.pi * (inputs_eje["arb_d_ext_m"]**4 - inputs_eje["arb_d_int_m"]**4) / 32
    k_torsion = inputs_eje["G_material"] * J / inputs_eje["arb_ancho_m"]
    k_arb_lineal = k_torsion / inputs_eje["arb_brazo_m"]**2
    kw_arb = k_arb_lineal * mr_arb**2

    # 4. Cargas y Recorridos (CORRECCIONES APLICADAS)
    f_static = ms * vehiculo["g_gravedad"] + downforce_por_rueda
    
    # --- CORRECCIÓN 2: TRANSFERENCIA LONGITUDINAL PONDERADA ---
    transfer_long_total = (vehiculo["peso_total_kg"] * vehiculo["g_long"] * vehiculo["g_gravedad"] * vehiculo["altura_cg_m"]) / vehiculo["dist_ejes_m"]
    
    if es_delantero:
        delta_f_brake = (transfer_long_total * weight_frac) / 2 # Ponderado por peso eje
    else:
        delta_f_brake = - (transfer_long_total * weight_frac) / 2 

    # --- CORRECCIÓN 1: TRANSFERENCIA LATERAL (RUEDA EXTERNA) ---
    # Fórmula corregida: 2 * (masa_esquina) * ... para simular rueda externa pura
    transfer_lat = 2 * (ms + inputs_eje["mu_kg"]) * vehiculo["g_lat"] * vehiculo["g_gravedad"] * vehiculo["altura_cg_m"] / vehiculo["ancho_via_m"]
    
    delta_f_corner = transfer_lat # Asignación directa (Rueda Externa)

    f_total_rueda = f_static + delta_f_brake + delta_f_corner
    f_suspension = f_total_rueda * (kw_spring / (kw_spring + k_tire))
    f_damper_total = f_suspension / mr_damper

    # --- CORRECCIÓN 3: USO DE ARB (ELIMINADA DE RECORRIDO 1/4) ---
    travel_static_wheel = f_static / kw_spring
    
    # En modelo 1/4 (heave puro), la ARB no resiste. Solo actúa el resorte.
    travel_dynamic_wheel = (delta_f_brake / kw_spring) + (delta_f_corner / kw_spring)
    
    travel_total_wheel = travel_static_wheel + travel_dynamic_wheel
    travel_damper_mm = travel_total_wheel * mr_damper * 1000
    margen_bloqueo = (inputs_eje["resorte_l_libre_mm"] - travel_damper_mm) - inputs_eje["resorte_l_solido_mm"]

    # 5. Amortiguación y Frecuencias
    k_ride = (kw_spring * k_tire) / (kw_spring + k_tire)
    wn = math.sqrt(k_ride / ms)
    fn = wn / (2 * np.pi)
    
    # --- CORRECCIÓN 4: AMORTIGUACIÓN CRÍTICA CON K_RIDE ---
    # Usamos k_ride para consistencia con wn
    c_crit_wheel = 2 * math.sqrt(k_ride * ms)
    
    c_reb_shaft = (inputs_eje["zeta_rebound"] * c_crit_wheel) / (mr_damper**2)
    c_comp_shaft = (inputs_eje["zeta_compression"] * c_crit_wheel) / (mr_damper**2)

    vels = np.linspace(0, inputs_eje["v_max_plot"], 50)
    f_reb_plot = c_reb_shaft * vels
    f_comp_plot = -c_comp_shaft * vels

    return {
        "ms": ms, 
        "mu": inputs_eje["mu_kg"], 
        "mr_damper": mr_damper,
        "kw_spring": kw_spring, 
        "kw_arb": kw_arb, 
        "k_tire": k_tire, 
        "fn": fn,
        "downforce_por_rueda": downforce_por_rueda, 
        "f_total_rueda": f_total_rueda,
        "f_suspension": f_suspension, 
        "f_damper_total": f_damper_total,
        "k_ride": k_ride, 
        "travel_total_wheel": travel_total_wheel,
        "travel_damper_mm": travel_damper_mm, 
        "margen_bloqueo": margen_bloqueo,
        "c_reb_shaft": c_reb_shaft, 
        "c_comp_shaft": c_comp_shaft,
        "vels": vels, 
        "f_reb_plot": f_reb_plot, 
        "f_comp_plot": f_comp_plot,
        "inputs": inputs_eje
    }

