#  BLOQUE 1: INPUTS GENERALES DEL VEHÍCULO (GLOBALES)
# =============================================================================
vehiculo_global = {
    "peso_total_kg": 350.0,
    "dist_ejes_m": 1.650,
    "dist_cg_del_m": 1.0,
    "altura_cg_m": 0.30,
    "ancho_via_m": 1.200,
    "g_lat": 1.5,
