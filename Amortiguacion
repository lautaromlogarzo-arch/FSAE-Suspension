    "g_gravedad": 9.81,
    "downforce_total_N": 0,
    "aero_bal_front_pct": 0.45
}

# --- DEFINICIÓN DE LA PISTA PARA SIMULACIÓN ---
v_car = 15.0  # m/s

# Bache Único
h_bache = 0.05
L_bache = 0.50
T_bache = L_bache / v_car

# Piano (Rumble Strip)
h_piano = 0.04
pitch = 0.10
L_diente = 0.08

def road_bache(t):
    if 0 <= t <= T_bache:
        return h_bache/2 * (1 - np.cos(2*np.pi*t/T_bache))
    return 0.0

def road_piano(t):
    x = v_car * t
    fase = x % pitch
    if fase <= L_diente:
        return h_piano/2 * (1 - np.cos(2*np.pi*fase/L_diente))
    return 0.0

