#  EJECUCIÓN PRINCIPAL
# =============================================================================
if __name__ == "__main__":
    print("Calculando parámetros estáticos...")
    res_f = calcular_dinamica_eje(front_inputs, vehiculo_global, True)
    res_r = calcular_dinamica_eje(rear_inputs, vehiculo_global, False)

    # 1. Reportes de Texto
    imprimir_reporte(res_f, "DELANTERO")
    imprimir_reporte(res_r, "TRASERO")
    
    # 2. Gráfico F-v-V Comparativo
    graficar_fvv_comparativo(res_f, res_r)

    # 3. Simulaciones y Gráficos Transitorios
    print("\nEjecutando simulación DELANTERA...")
    sim_f_bache = simular_eje_transitorio(res_f, road_bache)
    sim_f_piano = simular_eje_transitorio(res_f, road_piano)
    graficar_simulacion_completa(sim_f_bache, sim_f_piano, "DELANTERO")

    print("Ejecutando simulación TRASERA...")
    sim_r_bache = simular_eje_transitorio(res_r, road_bache)
    sim_r_piano = simular_eje_transitorio(res_r, road_piano)
    graficar_simulacion_completa(sim_r_bache, sim_r_piano, "TRASERO")

    # =============================================================================
    #  BLOQUE EXTRA: CÁLCULO DE RIGIDEZ DE ROLIDO Y BALANCE (LLTD)
    # =============================================================================

    print("\n" + "="*65)
    print(" CÁLCULO DE BALANCE (Rigidez de Rolido)")
    print("="*65)

    # 1. Recuperar datos calculados
    kw_spring_del = res_f['kw_spring']
    kw_arb_del = res_f.get('kw_arb', 0)
    
    kw_spring_tra = res_r['kw_spring']
    kw_arb_tra = res_r.get('kw_arb', 0)

    # Geometría
    track_del = vehiculo_global['ancho_via_m']
    track_tra = vehiculo_global['ancho_via_m']
    
    # Masas (Recalculadas para reporte)
    mu_del_ref = front_inputs["mu_kg"]
    mu_tra_ref = rear_inputs["mu_kg"]
    masa_susp_total = vehiculo_global['peso_total_kg'] - (2*mu_del_ref) - (2*mu_tra_ref)
    
    masa_del_susp = masa_susp_total * ((vehiculo_global['dist_ejes_m'] - vehiculo_global['dist_cg_del_m']) / vehiculo_global['dist_ejes_m'])
    masa_tra_susp = masa_susp_total - masa_del_susp

    # 2. Cálculo de Rigidez de Rolido (K_roll) [Nm/rad]
    kroll_spring_del = (kw_spring_del * track_del**2) / 2
    kroll_arb_del    = (kw_arb_del * track_del**2) / 2
    kroll_total_del  = kroll_spring_del + kroll_arb_del

    kroll_spring_tra = (kw_spring_tra * track_tra**2) / 2
    kroll_arb_tra    = (kw_arb_tra * track_tra**2) / 2
    kroll_total_tra  = kroll_spring_tra + kroll_arb_tra

    kroll_total_vehiculo = kroll_total_del + kroll_total_tra

    # 3. Distribución (LLTD)
    roll_dist_front = kroll_total_del / kroll_total_vehiculo

    # 4. Diagnóstico
    if roll_dist_front > 0.55:
        balance_msg = "Tendencia a SUBVIRAJE (Front Stiff - Seguro)"
    elif roll_dist_front < 0.45:
        balance_msg = "Tendencia a SOBREVIRAJE (Rear Stiff - Ágil)"
    else:
        balance_msg = "Balance NEUTRAL (Zona Típica FSAE)"

    # 5. Imprimir Reporte
    print(f"Masa Susp. Eje Del:       {masa_del_susp:.1f} kg ({(masa_del_susp/masa_susp_total)*100:.1f}%)")
    print(f"Masa Susp. Eje Tra:       {masa_tra_susp:.1f} kg")
    print("-" * 45)
    print(f"Rigidez Rolido DELANTERA: {kroll_total_del:.1f} Nm/rad")
    print(f"   > Aporte Resortes:     {kroll_spring_del:.1f} Nm/rad")
    print(f"   > Aporte ARB:          {kroll_arb_del:.1f} Nm/rad")
    print("-" * 45)
    print(f"Rigidez Rolido TRASERA:   {kroll_total_tra:.1f} Nm/rad")
    print(f"   > Aporte Resortes:     {kroll_spring_tra:.1f} Nm/rad")
    print(f"   > Aporte ARB:          {kroll_arb_tra:.1f} Nm/rad")
    print("=" * 65)
    print(f"RIGIDEZ TOTAL CHASIS:     {kroll_total_vehiculo:.1f} Nm/rad")
    print(f"DISTRIBUCIÓN DELANTERA:   {roll_dist_front*100:.2f} %")
    print(f"DIAGNÓSTICO:              {balance_msg}")
    print("=" * 65)
