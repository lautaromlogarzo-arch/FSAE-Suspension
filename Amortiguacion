def graficar_fvv_comparativo(res_f, res_r):
    plt.figure(figsize=(10,6))
    plt.plot(res_f['vels']*1000, res_f['f_reb_plot'], 'r-', linewidth=2, label='Delantero Reb')
    plt.plot(res_f['vels']*1000, res_f['f_comp_plot'], 'r--', linewidth=2, label='Delantero Comp')
    plt.plot(res_r['vels']*1000, res_r['f_reb_plot'], 'b-', linewidth=2, label='Trasero Reb')
    plt.plot(res_r['vels']*1000, res_r['f_comp_plot'], 'b--', linewidth=2, label='Trasero Comp')
    plt.title("Comparativa Amortiguación: Delantero vs Trasero")
    plt.xlabel("Velocidad Vástago (mm/s)"); plt.ylabel("Fuerza (N)")
    plt.axhline(0, color='k'); plt.grid(True, linestyle='--'); plt.legend()
    plt.show()

# =============================================================================
#  BLOQUE 4: MOTOR DE SIMULACIÓN TRANSITORIA
# =============================================================================

def simular_eje_transitorio(res_data, road_function, t_end=2.0):
    ms = res_data['ms']
    mu = res_data['mu']
    kw = res_data['kw_spring'] # SOLO RESORTE (ARB DESACOPLADA EN 1/4)
    kt = res_data['k_tire']
    MR = res_data['mr_damper']
    
    c_reb_wheel = res_data['c_reb_shaft'] * (MR**2)
    c_comp_wheel = res_data['c_comp_shaft'] * (MR**2)

    def eom(t, z):
        xs, xsd, xu, xud = z
        y = road_function(t)
        vel_rel = xsd - xud
        c_inst = c_reb_wheel if vel_rel > 0 else c_comp_wheel
        
        xsd_dot = (-kw*(xs-xu) - c_inst*(xsd-xud)) / ms
        xud_dot = (kw*(xs-xu) + c_inst*(xsd-xud) - kt*(xu-y)) / mu
        return [xsd, xsd_dot, xud, xud_dot]

    t_eval = np.linspace(0, t_end, 2000)
    sol = solve_ivp(eom, (0, t_end), [0,0,0,0], t_eval=t_eval, method='RK45')

    travel_wheel = sol.y[0] - sol.y[2]
    travel_damper_mm = travel_wheel * MR * 1000
    road_ref_damper_mm = np.array([road_function(t) for t in sol.t]) * MR * 1000
    
    return sol.t, travel_damper_mm, road_ref_damper_mm

# =============================================================================
#  BLOQUE 5: GRÁFICOS TRANSITORIOS
# =============================================================================

def graficar_simulacion_completa(sim_bache, sim_piano, nombre_eje):
    t_b, trav_b, road_b = sim_bache
    t_p, trav_p, road_p = sim_piano

    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))
    fig.suptitle(f"Análisis Transitorio - Eje {nombre_eje}", fontsize=14, fontweight='bold')

    ax1.plot(t_b, road_b, linestyle='--', color='gray', alpha=0.5, label='Perfil Suelo (Ref. Damper)')
    ax1.plot(t_b, trav_b, color='#e74c3c', linewidth=2.5, label='Recorrido Amortiguador')
    ax1.set_title(f"Respuesta ante Bache ({h_bache}m)")
    ax1.set_xlabel("Tiempo [s]"); ax1.set_ylabel("Recorrido [mm]")
    ax1.set_xlim(0, t_b[-1]); ax1.grid(True, alpha=0.3)
    ax1.legend(); ax1.axhline(0, color='black', linewidth=1)

    ax2.plot(t_p, road_p, linestyle='--', color='gray', alpha=0.5, label='Perfil Piano (Ref.)')
    ax2.plot(t_p, trav_p, color='#3498db', linewidth=2, label='Recorrido Amortiguador')
    ax2.set_title(f"Respuesta en Piano ({pitch}m pitch) – Análisis Packing")
    ax2.set_xlabel("Tiempo [s]"); ax2.set_ylabel("Recorrido [mm]")
    ax2.set_xlim(0, t_p[-1]); ax2.grid(True, alpha=0.3)
    ax2.legend(); ax2.axhline(0, color='black', linewidth=1)

    minimos = np.minimum.accumulate(trav_p)
    idx_start = np.argmax(t_p > 0.5) 
    packing_mm = minimos[-1] - minimos[idx_start]

    if packing_mm < -3.0:
        txt = (f"PACKING DETECTADO\nDesplazamiento: {packing_mm:.1f} mm\n(Rebound excesivo)")
        ax2.text(0.5, 0.05, txt, transform=ax2.transAxes, ha='center', va='bottom',
                 color='red', fontweight='bold', bbox=dict(facecolor='white', alpha=0.8, edgecolor='red'))

    plt.tight_layout()
    plt.show()

